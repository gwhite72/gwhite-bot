+/*========================================================================*/
+/* Fallback font (Flipper zh-TW localization)                             */
+/* When a glyph is missing from the current font, look it up in a second  */
+/* font instead. The current font and its decoded header are swapped out  */
+/* only for the duration of one glyph operation, then restored.           */
+
+static const uint8_t* u8g2_fallback_font = NULL;
+static u8g2_font_info_t u8g2_fallback_font_info;
+
+void u8g2_SetFallbackFont(const uint8_t* font) {
+    u8g2_fallback_font = font;
+    if(font != NULL) u8g2_read_font_info(&u8g2_fallback_font_info, font);
+}
+
+typedef struct {
+    const uint8_t* font;
+    u8g2_font_info_t font_info;
+    uint8_t active;
+} u8g2_fallback_state_t;
+
+static const uint8_t* u8g2_get_glyph_with_fallback(
+    u8g2_t* u8g2,
+    uint16_t encoding,
+    u8g2_fallback_state_t* state) {
+    state->active = 0;
+    const uint8_t* glyph_data = u8g2_font_get_glyph_data(u8g2, encoding);
+    if(glyph_data == NULL && encoding > 0x7e && u8g2_fallback_font != NULL &&
+       u8g2->font != u8g2_fallback_font) {
+        state->font = u8g2->font;
+        state->font_info = u8g2->font_info;
+        u8g2->font = u8g2_fallback_font;
+        u8g2->font_info = u8g2_fallback_font_info;
+        glyph_data = u8g2_font_get_glyph_data(u8g2, encoding);
+        if(glyph_data != NULL) {
+            state->active = 1;
+        } else {
+            u8g2->font = state->font;
+            u8g2->font_info = state->font_info;
+        }
+    }
+    return glyph_data;
+}
+
+static void u8g2_fallback_restore(u8g2_t* u8g2, const u8g2_fallback_state_t* state) {
+    if(state->active) {
+        u8g2->font = state->font;
+        u8g2->font_info = state->font_info;
+    }
+}
